{
  "name": "stock-value-android-e2e",
  "private": true,
  "type": "module",
  "description": "End-to-end tests for the Android app: WebdriverIO + TypeScript + Appium (UiAutomator2), with Allure reports.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "wdio run wdio.conf.ts",
    "test:mock": "wdio run wdio.conf.ts --suite mock",
    "test:live": "wdio run wdio.conf.ts --suite live",
    "appium:drivers": "appium driver list --installed",
    "report": "allure generate allure-results",
    "report:open": "allure open allure-report",
    "test:a11y": "wdio run wdio.conf.ts --spec ./specs/mock/accessibility.e2e.ts --spec ./specs/live/accessibility.e2e.ts"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.4",
    "@wdio/allure-reporter": "9.32.0",
    "@wdio/appium-service": "9.32.0",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "allure": "3.18.0",
    "appium": "3.8.0",
    "appium-uiautomator2-driver": "8.7.0",
    "axe-core": "4.13.0",
    "fast-xml-parser": "5.11.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "webdriverio": "9.32.0"
  }
}
